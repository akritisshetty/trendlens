# TrendLens environment configuration.
# Copy this file to `.env` (project root) and fill in values.
# `config.py` loads `.env` automatically and never overrides real env vars.

# --- Instagram scraping via Apify (REQUIRED) ---
# Get your token at: https://apify.com/account#/integrations
APIFY_API_TOKEN=your_apify_api_token

# --- Instagram scan window ---
# Number of days to fetch (default: 10)
TRENDLENS_INSTAGRAM_DAYS=10

# --- Chat interface (Gemini ONLY) ---
# The Chat page answers questions about food and fashion photography
# with Gemini, and generates representative images with Gemini's image model.
TRENDLENS_GEMINI_API_KEY=
TRENDLENS_GEMINI_MODEL=gemini-3.1-flash-lite
TRENDLENS_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Number of relevant representative images per answer (0 disables image generation)
TRENDLENS_GEMINI_IMAGE_COUNT=4
# Use Google Search grounding for current trends (1 = on, 0 = off)
TRENDLENS_GEMINI_SEARCH_GROUNDING=1
# Images load after the text answer. This caps the image stage in seconds
# (reference search + generation share the same deadline).
TRENDLENS_CHAT_IMAGE_BUDGET=15
# Per-source network caps (seconds); lower = snappier, fewer images.
TRENDLENS_YANDEX_TIMEOUT=6
TRENDLENS_IMAGE_DOWNLOAD_TIMEOUT=8
TRENDLENS_POLLINATIONS_TIMEOUT=12
TRENDLENS_IMAGE_GEN_TIMEOUT=20
# Optional quality passes. Both use CLIP and cost 10-30s on CPU, so they are
# off by default; enable them if you have a GPU or can trade speed for matches.
TRENDLENS_CHAT_IMAGE_RELEVANCE=0
TRENDLENS_CHAT_CORPUS_IMAGES=0

# --- LLM writing layer for the legacy pipeline (OPTIONAL) ---
# provider: "gemini" | "openai" | "ollama"
TRENDLENS_LLM_PROVIDER=
TRENDLENS_LLM_API_KEY=
TRENDLENS_LLM_MODEL=
TRENDLENS_LLM_BASE_URL=

# --- Live trend source (OPTIONAL — legacy Reddit/Wikimedia fallback) ---
TRENDLENS_LIVE_SOURCE=auto
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TRENDLENS_SUBREDDITS=foodporn,coffee
TRENDLENS_WIKIMEDIA_QUERIES=latte art,coffee,street food,breakfast
TRENDLENS_WIKIMEDIA_LIMIT=10
TRENDLENS_WIKIMEDIA_DAYS=90
TRENDLENS_WIKIMEDIA_RECENT_DAYS=30

# --- API server ---
TRENDLENS_API_HOST=0.0.0.0
TRENDLENS_API_PORT=8000

# ── Feedback email (Gmail SMTP) ──────────────────────────────────────────
# Recipient of all thought/feedback submissions (never shown in the UI)
TRENDLENS_FEEDBACK_EMAIL=
# Gmail account that SENDS the mail + its App Password (requires 2FA:
# Google Account > Security > 2-Step Verification > App passwords)
TRENDLENS_EMAIL_USER=you@gmail.com
TRENDLENS_EMAIL_APP_PASSWORD=your_16_char_app_password
